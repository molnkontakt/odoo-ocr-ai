<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ocr" model="ir.ui.view">
        <field name="name">account.move.form.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_run_ocr"
                        type="object"
                        string="Kör OCR igen"
                        class="btn-secondary"
                        invisible="state != 'draft' or move_type != 'in_invoice'"/>
            </xpath>
            <!-- The vendor bill's recipient account (not the customer invoice's) -->
            <xpath expr="//field[@name='partner_bank_id'][contains(@invisible, 'in_invoice')]"
                   position="after">
                <field name="ocr_auto_debit"
                       invisible="move_type not in ('in_invoice', 'in_receipt')"/>
                <field name="ocr_auto_debit_phrase"
                       invisible="move_type not in ('in_invoice', 'in_receipt') or not ocr_auto_debit_phrase"/>
            </xpath>
        </field>
    </record>
</odoo>
