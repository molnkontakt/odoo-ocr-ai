<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_expense_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.expense.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_invoice_ocr_ai.res_config_settings_view_form_invoice_ocr"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoice_ocr_settings']" position="inside">
                <setting string="Expense receipt OCR" help="Reads receipt photos and PDFs on e-mailed expenses and on drafts that get a main attachment. Same AI provider and keys as above.">
                    <field name="expense_ocr_enabled"/>
                </setting>
                <setting string="Placeholder name prefixes" help="Comma-separated. An expense whose description starts with one of these gets the receipt's description appended, e.g. the subject a mail alias gives expenses from unknown senders.">
                    <field name="expense_ocr_placeholder_name_prefixes"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
