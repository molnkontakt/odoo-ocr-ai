msgid "the file is not an image that can be read"
msgstr "filen är ingen bild som går att läsa"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid "the image"
msgstr "bilden"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid ""
"the image (%(width)s×%(height)s) was scaled down to %(megapixels)s "
"megapixels for OCR"
msgstr ""
"bilden (%(width)s×%(height)s) skalades ned till %(megapixels)s megapixel "
"för OCR"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid "the merchant name \"%(merchant)s\" is not printed on the receipt — ignored"
msgstr "butiksnamnet \"%(merchant)s\" står inte på kvittot — ignorerat"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid "the model's date %(date)r is not a valid date — ignored"
msgstr "modellens datum %(date)r är inget giltigt datum — ignorerat"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid ""
"the photo is only %(width)s×%(height)s pixels: OCR misreads digits on a "
"photo this small, so amount and date are filled only with confidence "
"%(needed)s or more (here %(confidence)s) — they are not filled"
msgstr ""
"fotot är bara %(width)s×%(height)s pixlar: OCR läser fel siffror på så små "
"foton, så belopp och datum fylls bara i med konfidens %(needed)s eller mer "
"(här %(confidence)s) — de fylls inte i"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/models/hr_expense.py:0
msgid ""
"the receipt is in %(currency)s, but %(problem)s – the amount was not filled"
msgstr "kvittot är i %(currency)s, men %(problem)s – beloppet fylldes inte i"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/models/hr_expense.py:0
msgid ""
"the receipt shows VAT %(printed)s, the category's tax gives %(computed)s – "
"check the VAT rate"
msgstr ""
"kvittot visar moms %(printed)s, kategorins moms ger %(computed)s – "
"kontrollera momssatsen"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid "the text of %(name)s could not be read: %(error)s"
msgstr "texten i %(name)s kunde inte läsas: %(error)s"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid "the time for reading the image was used up – it was not read"
msgstr "tiden för att läsa bilden tog slut – den lästes inte"

#. module: hr_expense_ocr_ai
#. odoo-python
#: code:addons/hr_expense_ocr_ai/lib/receipt_ocr.py:0
msgid ""
"the total is in %(currency)s – a foreign amount is not read without the AI, "
"the amount stays empty"
msgstr ""
"totalen är i %(currency)s – ett utländskt belopp läses inte utan AI:n, "
"beloppet lämnas tomt"
