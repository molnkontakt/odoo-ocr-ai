<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_read_receipt_server" model="ir.actions.server">
        <field name="name">Read receipt (OCR)</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
# Queues the receipts; the OCR cron reads them within seconds. A summary comes back.
action = records.action_read_receipt_bulk()
        </field>
    </record>
</odoo>
